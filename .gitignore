# Track only wiki source and research documentation in this game installation.
/*
!/.gitignore
!/README.md
!/wiki/
!/research/
wiki/node_modules/
wiki/.next/
wiki/.releases/
wiki/hosting.json
wiki/deploy.compose.yml
wiki/legacy-static/
**/__pycache__/
**/*.pyc
**/.env
**/.env.*
