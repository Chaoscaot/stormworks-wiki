{
  "name": "stormworks-wiki",
  "version": "1.0.0",
  "private": true,
  "description": "Read-only Stormworks wiki built with Next.js from the generated research JSON in data/.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/prepare-standalone.mjs && node .next/standalone/server.js",
    "test": "node --test \"test/unit/*.test.mjs\"",
    "test:routes": "node test/routes.mjs",
    "test:browser": "bash test/browser-qa.sh"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "type": "module"
}
