    "contact_grip_request": "50*grip_factor*tire_factor/r * (2000*memory + 100*tangential_slip)",
    "grip_limits": "relative slip length 5 before projection; tangent length <=100*r; memory length <=0.1*r",
    "shaft_reaction": "RPS += dot(tangent_slip, wheel_tangent)/(2*pi_float*r)*tire_factor*grip_factor*0.5",
    "track_sync": "mean(signed RPS), mean(shaft weight), separately",
    "bullet_damping": "v *= (1-d_linear)^dt; omega *= (1-d_angular)^dt",
    "bullet_material_friction": "clamp(mu_A*mu_B,-10,10)"
